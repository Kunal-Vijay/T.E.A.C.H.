DATABASE_URL=sqlite:///./teach.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
S3_BUCKET=ai-tutor-assets-dev
STAGE=dev
REGION=ap-south-1
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
LIVE_CLASS_CONTENT_GENERATION_QUEUE_URL=
LIVE_CLASS_IMAGE_GENERATION_QUEUE_URL=
SYNC_GENERATION=true

# --- Amazon Bedrock / Nova Sonic (voice "check your understanding") ---
# us-west-2 hosts amazon.nova-2-sonic-v1:0. The older amazon.nova-sonic-v1:0 is a
# different region set — run scripts/check_bedrock_access.py to confirm before changing.
# If you are using temporary STS credentials, AWS_SESSION_TOKEN is required and the
# whole set expires after a few hours.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_SONIC_VOICE_ID=matthew

# Keep max tokens low — this is the main lever on how much the tutor says per turn.
NOVA_SONIC_MAX_TOKENS=320
NOVA_SONIC_TEMPERATURE=0.6
# HIGH = fastest replies but clips slow speakers, LOW = waits longer (better for a
# student thinking mid-sentence), MEDIUM = AWS default.
NOVA_SONIC_ENDPOINTING_SENSITIVITY=LOW

# Viva bounds. The session ends on whichever limit is hit first.
VIVA_MAX_QUESTIONS=10
VIVA_MAX_SECONDS=120

# Text model that grades the transcript afterwards.
# auto = Bedrock if AWS creds exist, else Gemini, else an offline placeholder.
ASSESSMENT_PROVIDER=auto
BEDROCK_ASSESSMENT_MODEL_ID=amazon.nova-lite-v1:0
