# API base URL (required in production — e.g. https://api.example.com)
VITE_API_BASE_URL=http://localhost:8000

# Observability (optional — no-op when empty)
VITE_SENTRY_DSN=
VITE_ANALYTICS_ENABLED=false

# Feature flags (optional)
VITE_FLAG_SAGE_STREAMING=false
VITE_FLAG_DELIGHT_GAMIFICATION=true

# Avatar system — set USE_INTERACTIVE_AVATAR=true in docs; Vite exposes as:
VITE_USE_INTERACTIVE_AVATAR=true
# Interactive teacher character: female-teacher | male-teacher
VITE_DEFAULT_AVATAR_CHARACTER=female-teacher
